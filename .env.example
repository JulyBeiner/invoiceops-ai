# Copy this file to .env and fill in the values. .env is never committed.

# Back-end
DATABASE_URL=postgresql://gitpod:postgres@localhost:5432/example
FLASK_APP=src/app.py
FLASK_APP_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# Password-reset email (Brevo). Optional in development: without a key the
# email is not sent and the app keeps working.
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
# Public URL of the app, used in the reset link.
FRONTEND_URL=http://localhost:3000

# AI features (openai or gemini). Optional: without a key the AI buttons
# say the AI is not configured and everything else works.
AI_PROVIDER=openai
AI_API_KEY=
# Optional overrides of the model names (see src/api/services/ai.py).
# AI_MODEL=
# AI_AUDIO_MODEL=